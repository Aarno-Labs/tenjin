pub unsafe extern "C" fn my_printf(mut fmt: *const u8, mut c2rust_args: ...) {
    let mut ap: ::core::ffi::VaList;
    ap = c2rust_args.clone();
    while *fmt != 0 {
        match *fmt as ::core::ffi::c_int {
            37 => {
                fmt = fmt.offset(1);
                if *fmt != 0 {
                    match *fmt as ::core::ffi::c_int {
                        105 | 100 => {
                            ::xj_cio::printf!(b"%d", ap.arg::<::core::ffi::c_int>());
                        }
                        102 => {
                            ::xj_cio::printf!(b"%f", ap.arg::<::core::ffi::c_double>());
                        }
                        115 => {
                            ::xj_cio::printf_raw!(b"%s", ap.arg::<*mut u8>());
                        }
                        _ => {}
                    }
                }
            }
            _ => {
                ::xj_cio::printf!(b"%c", *fmt as ::core::ffi::c_int);
            }
        }
        fmt = fmt.offset(1);
    }
}
