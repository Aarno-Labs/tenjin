#[unsafe(export_name = "use")]
pub unsafe extern "C" fn r#use(mut i: ::core::ffi::c_int) -> ::core::ffi::c_int {
    return greeting.as_bytes().get(i as usize).copied().unwrap_or(0) as ::core::ffi::c_char
        as ::core::ffi::c_int
        + nothing.is_empty() as ::core::ffi::c_int
        + view.as_bytes().get(i as usize).copied().unwrap_or(0) as ::core::ffi::c_char
